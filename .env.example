# =====================================================================
# CONFIGURAÇÕES DO TELEGRAM BOT
# =====================================================================
# Token fornecido pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=8949673934:AAEjhmDizSs0hbhhDVXDnNXf8fLr1PA1KlQ

# =====================================================================
# CONFIGURAÇÕES DO FIREBASE FIRESTORE (BACKEND PYTHON)
# =====================================================================
# Caminho para o arquivo JSON de credenciais da conta de serviço
FIREBASE_CREDENTIALS_PATH=chave-firebase.json

# =====================================================================
# CONFIGURAÇÕES DO SERVIDOR LOCAL / CLOUD RUN (PYTHON)
# =====================================================================
# Porta de execução da API Flask
PORT=8080

# Ativar polling local contínuo do Telegram (true para local, false para webhook em produção)
ENABLE_POLLING=true

# =====================================================================
# CONFIGURAÇÕES DO FRONTEND (REACT / VITE)
# =====================================================================
# URL base da API backend (deixe vazio para backend local ou coloque a URL do Cloudflare Worker / Cloud Run)
VITE_API_URL=https://rotina-metas-api.rotinas.workers.dev

# Senha secreta para autenticação na API (se configurada no Cloudflare Worker)
# API_SECRET_KEY=sua_senha_secreta_aqui
